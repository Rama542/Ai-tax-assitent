# AI TaxOS Backend Environment Variables
# Copy this to .env and fill in your Firebase credentials

PORT=5000
NODE_ENV=development

# Firebase Admin SDK
# Option 1: Place serviceAccountKey.json in backend/ directory (recommended)
# Download from: Firebase Console → Project Settings → Service Accounts → Generate Key

# Option 2: Environment variables
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com

# AI Service URL
AI_SERVICE_URL=http://localhost:8000
